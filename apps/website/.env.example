# Nomploy website — environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
# Every variable below is optional; the site builds and runs without them,
# but the related feature stays inactive (e.g. the blog shows "No posts
# available" until the Ghost credentials are set).

# --- Public site URL -------------------------------------------------------
# Absolute base URL of the deployed site. Used to build canonical and
# OpenGraph URLs for blog posts. No trailing slash.
NEXT_PUBLIC_APP_URL=https://nomploy.com

# --- Blog (Ghost CMS) ------------------------------------------------------
# Content API URL and key for the Ghost instance that powers /blog.
# Without these the blog pages render but list no posts.
GHOST_URL=https://your-ghost-instance.com
GHOST_KEY=your_ghost_content_api_key

# --- Contact form: email delivery (Resend) ---------------------------------
# API key used by /api/contact to send emails via Resend.
RESEND_API_KEY=your_resend_api_key

# --- Contact form: Slack notifications -------------------------------------
# Incoming webhook URL that contact-form submissions are posted to.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Contact form: HubSpot ---------------------------------------------------
# HubSpot portal ID and form GUID that contact-form submissions are sent to.
HUBSPOT_PORTAL_ID=your_hubspot_portal_id
HUBSPOT_FORM_GUID=your_hubspot_form_guid
